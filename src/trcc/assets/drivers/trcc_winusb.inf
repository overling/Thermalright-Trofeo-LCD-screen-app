; trcc_winusb.inf -- WinUSB driver binding for TRCC LCD devices
;
; Associates TRCC's USB bulk/LY LCD devices with Windows' inbox WinUSB
; driver so libusb can communicate with them.  No external driver binary
; is needed -- winusb.sys ships with all supported Windows versions.
;
; Install silently (requires admin):
;   pnputil /add-driver trcc_winusb.inf /install
;
; TRCC devices covered (Wire.BULK / Wire.BULK_ALI / Wire.LY):
;   0x0416:0x5406  Elite Vision 360 (BULK_ALI)
;   0x87AD:0x70DB  GrandVision 360 AIO (BULK)
;   0x0416:0x5408  Trofeo Vision 9.16 (LY)
;   0x0416:0x5409  Trofeo Vision 9.16 (LY)
;
; HID (0x0416:0x5302, 0x0418:0x5303, 0x0418:0x5304, 0x0416:0x8001) and
; SCSI (0x87CD:0x70DB, 0x0402:0x3922) devices are NOT listed here --
; they use Windows' built-in HID / mass-storage drivers.

[Version]
Signature           = "$Windows NT$"
Class               = USB
ClassGuid           = {78a1c341-4539-11d3-bd40-00c04fd8b5c3}
Provider            = "TRCC"
DriverVer           = 07/16/2026,1.0.0.0
CatalogFile.NTamd64 = trcc_winusb.cat
CatalogFile.NTarm64 = trcc_winusb.cat

[Manufacturer]
"TRCC" = TRCC,NTamd64,NTarm64

[TRCC.NTamd64]
"TRCC LCD Device" = USB_Install, USB\VID_0416&PID_5406
"TRCC LCD Device" = USB_Install, USB\VID_87AD&PID_70DB
"TRCC LCD Device" = USB_Install, USB\VID_0416&PID_5408
"TRCC LCD Device" = USB_Install, USB\VID_0416&PID_5409

[TRCC.NTarm64]
"TRCC LCD Device" = USB_Install, USB\VID_0416&PID_5406
"TRCC LCD Device" = USB_Install, USB\VID_87AD&PID_70DB
"TRCC LCD Device" = USB_Install, USB\VID_0416&PID_5408
"TRCC LCD Device" = USB_Install, USB\VID_0416&PID_5409

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.HW]
AddReg = WinUSB_AddReg

[WinUSB_AddReg]
HKR,,DriverFlags,0x00010001,0x00000000
HKR,,InterfaceGUID,0x00000000,"{dcac0a7c-1a1e-4f59-9eaa-9a1f4f4b1c3e}"

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[Strings]
TRCC = "TRCC"
